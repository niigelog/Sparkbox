{
  "manifest_version": 3,
  "name": "X 收藏助手",
  "version": "0.1.0",
  "description": "点击 X 原生收藏按钮，自动抓取帖子并归档到你自己的收藏库",
  "permissions": [
    "storage",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开收藏库"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
