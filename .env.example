# 复制为 .env 后填写。构建时注入到 dist，切勿提交 .env。

# 同步目标：local = POST 到本地接口；supabase = 直连 Supabase
SYNC_TARGET=local

# SYNC_TARGET=local 时使用
SYNC_ENDPOINT=http://192.168.101.12:7000/api/posts

# SYNC_TARGET=supabase 时才需要以下四项
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
DEFAULT_EMAIL=default@yourapp.com
DEFAULT_PASSWORD=

# ---- Postgres ----
# 用 docker compose 时，容器内部固定走服务名 db（compose 里已写死）；
# 这里填的是「在宿主机上跑 npm run db:migrate / npm test 时」连的地址。
APP_POSTGRES_HOST=192.168.101.12
APP_POSTGRES_PORT=5432
APP_POSTGRES_DB=sparkbox_db
APP_POSTGRES_USER=app_pg_user
APP_POSTGRES_PASSWORD=

# ---- docker compose ----
# 已有 Postgres 容器所在的自定义网络，以及容器名。
# compose 只加入这个网络，不负责创建它。
PG_NETWORK=local-db-stack_db_net
PG_CONTAINER=postgres-17
PG_CONTAINER_PORT=5432

# API 在宿主机上的监听地址。默认只绑本机。
# 插件装在别的电脑上时才需要改成 0.0.0.0 —— 但接口没有鉴权，
# 那等于把全部收藏对整个局域网开放，改之前先想清楚。
API_BIND=127.0.0.1
